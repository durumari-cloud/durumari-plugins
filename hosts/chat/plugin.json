{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "durumari",
  "version": "0.1.3",
  "description": "Chat에서 승인한 프로젝트의 Durumari Cloud Context를 검색·읽기·저장합니다.",
  "author": {
    "name": "Durumari"
  },
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "두루마리",
        "shortDescription": "Chat에서 프로젝트의 Cloud Context 사용",
        "longDescription": "두루마리에 로그인하고 프로젝트 접근을 승인한 뒤, 필요한 Context를 검색·읽기·저장합니다.",
        "developerName": "Durumari",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "defaultPrompt": [
          "두루마리에서 현재 연결된 프로젝트를 확인해줘",
          "두루마리에서 이 프로젝트의 최신 Context를 찾아줘"
        ]
      }
    }
  }
}
